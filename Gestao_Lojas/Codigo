import json

produtos = []
vendas = []

def login():
    tentativas = 0
    usuario_correto = 'Programador'
    senha_correta = 'ABC_123'

    while tentativas < 3:
        usuario = input('Nome do usuario: ')
        senha = input('Senha do usuario: ')

        if usuario == usuario_correto and senha == senha_correta:
            print('Login realizado com sucesso!')
            return True
        else:
            tentativas += 1
            print('Dados de login incoretos!')

            if tentativas < 3:
                print(f'Tentativas restantes: {3 - tentativas}')

    print('Numero maximo de tentaivas atingido!')
    print('Acesso negado!')
    return False

def salvar_produtos():
    with open('produtos.json', 'w', encoding='utf-8') as arquivo:
        json.dump(produtos,arquivo, indent=4, ensure_ascii=False)

    print('Produto salvo com sucesso.')

def carregar_produtos():
    global produtos

    try:
        with open('produtos.json', 'r', encoding='utf-8') as arquivo:
            produtos = json.load(arquivo)
            print('Produtos caregados com sucesso.')

    except FileNotFoundError:
        produtos = []
        print('Arquivos de produtos nao encontrado. Um novo arquivo sera criado')

#=================================================================

def salvar_venda():
    with open('vendas.json', 'w', encoding='utf-8') as arquivo:
        json.dump(vendas,arquivo, ensure_ascii=False, indent=4)

def carregar_venda():
    global vendas

    try:
        with open('vendas.json', 'r', encoding='utf-8') as arquivo:
            vendas = json.load(arquivo)
    except FileNotFoundError:
        vendas = []
#==================================================================

#===================== Funcoes pricipais ==========================

def adicionar_produto():
    id = int(input('id: '))
    nome = input('nome: ')
    preco = int(input('preco: '))
    quantidade = int(input('quantidade: '))
    categoria = input('categoria: ')

    for produto in produtos:
        if produto['nome'] == nome:
            print('Esse produto ja foi registrado.')
            return

    novo_produto = {
        'id': id,
        'nome': nome,
        'preco': preco,
        'quantidade': quantidade,
        'categoria': categoria
    }
    produtos.append(novo_produto)
    salvar_produtos()
    print('Produto cadastrado com sucesso!')
    print('-='*30)


def listar_produtos():
    if len(produtos) == 0:
        print('A lista esta vazia!')
        return

    print('==== Lista de produtos ====')
    for produto in produtos:
        print(f'id: {produto['id']}')
        print(f'nome: {produto['nome']}')
        print(f'preco: {produto['preco']}')
        print(f'quantidade: {produto['quantidade']}')
        print(f'categoria: {produto['categoria']}')
        print('-='*30)


def pesquisar_produto(nome):
    for produto in produtos:
        if produto['nome'] == nome:
            print('Produto encontrado!')
            print(f'id: {produto['id']}')
            print(f'nome: {produto['nome']}')
            print(f'preco: {produto['preco']}')
            print(f'quantidade: {produto['quantidade']}')
            print(f'categoria: {produto['categoria']}')
            print('-='*30)
            return
    else:
        print('O produto pesquisado nao foi encontrado!')
        return

def alterar_preco(nome, novo_preco):
    for produto in produtos:
        if produto['nome'] == nome:
            produto['preco'] = novo_preco
            print('Um novo preco foi atribuido ao produto!')
            print('-=' * 30)
            return

def alterar_quantidade(nome, nova_quantidade):
    for produto in produtos:
        if produto['nome'] == nome:
            produto['quantidade'] = nova_quantidade
            print('Um nova quantidade foi atribuido ao produto! ')
            print('-=' * 30)
            return

def excluir_produto(nome):
    for produto in produtos:
        if produto['nome'] == nome:
            produtos.remove(produto)
            print('Produto excluido com sucesso!')
            print('-='*30)
            return
    else:
        print('Produto nao encontrado.')



def realizar_venda():
    nome = input('Nome do produto: ')
    quantidade_venda = int(input('quantidade: '))

    for produto in produtos:
        if produto['nome'] == nome:
            if produto['quantidade'] < quantidade_venda:
                print('Quantidade insuficiente no estoque.')
                return
            produto['quantidade'] -= quantidade_venda
            salvar_produtos()
            valor_total = produto['preco'] * quantidade_venda

            nova_venda = {
                'produto': produto['nome'],
                'quantidade': quantidade_venda,
                'valor_total': valor_total,
            }
            vendas.append(nova_venda)
            salvar_venda()
            print('Venda realizada com sucesso!')
            print(f'Valor total: {valor_total}')
            return

    print('Produto nao encontrado.')


def historico():
    if len(vendas) == 0:
        print('Nunhuma venda foi realizada.')
        return

    print('\n====== Historico de vendas ======')
    for venda in vendas:
        print(f'Produto: {venda['produto']}')
        print(f'Quanidade vendida: {venda['quantidade']}')
        print(f'Valor total: {venda['valor_total']}')
        print('-='*30)


def estatistica():

    quantidade_total_produtos = 0
    valor_total_estoque = 0

    maior_preco = None
    menor_preco = None
    produto_mais_caro = None
    produto_mais_barato = None

    maior_quantidade = None
    produto_maior_estoque = None

    total_vendas_realizadas = 0
    valor_total_vendido = 0

    for produto in produtos:
        quantidade_total_produtos += 1
        valor_total_estoque += produto['preco'] * produto['quantidade']

        if maior_preco is None or produto['preco'] > maior_preco:
            maior_preco = produto['preco']
            produto_mais_caro = produto['nome']


        if menor_preco is None or produto['preco'] < menor_preco:
            menor_preco = produto['preco']
            produto_mais_barato = produto['nome']

        if maior_quantidade is None or produto['quantidade'] > maior_quantidade:
            maior_quantidade = produto['quantidade']
            produto_maior_estoque = produto['nome']

        total_vendas_realizadas = len(vendas)
        for venda in vendas:
            valor_total_vendido += venda['valor_total']

    print(f'A quantidade total de produtos e de: {quantidade_total_produtos}')
    print(f'O valor total de estoque  e de: {valor_total_estoque}')
    print(f'O produto mais caro e: {produto_mais_caro}')
    print(f'O produto mais barato e: {produto_mais_barato}')
    print(f'O produto com maior quantidade em estoque e: {produto_maior_estoque}')
    print(f'Total vendas realizadas: {total_vendas_realizadas}')
    print(f'Valor total vendido: {valor_total_vendido}')

#======================== Melhorias ==========================
def estoque_baixo():
    encontrou = False

    print('==== Produtos com baixo estoque ====')
    for produto in produtos:
        if produto['quantidade'] <= 5:
            encontrou = True
            print(f'Nome: {produto['nome']}')
            print(f'Quantidade: {produto['quantidade']}')
            print('-='*30)

    if encontrou == False:
        print('Nenhum produto apresenta quantidade baixa')

def pesquisar_categoria(categoria):
    encontrou = False

    for produto in produtos:
        if produto['categoria'].lower() == categoria.lower():
            encontrou = True
            print(f'Nome: {produto['nome']}')
            print('-='*30)
    if encontrou == False:
        print('Nao existe nenhum produto dessa categoria.')

def relatorio_vendas_produto():
    if len(vendas) == 0:
        print(f'Nenhuma venda realizada.')
        return

    relatorio = {}

    for venda in vendas:
        nome = venda['produto']
        if nome not in relatorio:
            relatorio[nome] = {
                'quantidade': 0,
                'valor_total': 0,
            }

        relatorio[nome]['quantidade'] += venda['quantidade_venda']
        relatorio[nome]['valor_total'] += venda['valor_total']

    print('\n====== Relatorio de vendas ======')
    for nome, dados in relatorio.items():
        print(f'Produto: {nome}')
        print(f'Quantidade total vendida: {dados['quantidade']}')
        print(f'Valor total vendido: {dados['valor_total']}')
        print('-='*30)

#===============================================================
def menu():
    while True:
        print('01 - Cadastrar produto')
        print('02 - Listar produtos')
        print('03 - Pesquisar produto')
        print('04 - Alterar preco')
        print('05 - Alterar quantidade')
        print('06 - Excluir produto')
        print('07 - Realizar venda')
        print('08 - Historico')
        print('09 - Estatistica')
        print('10 - Estoque dos produtos')
        print('11 - Pesquisa por categoria')
        print('12 - Relatorio de vendas')
        print(' 0 - Sair')

        opcao = input('Escolha uma opcao: ')

        if opcao == '1':
            adicionar_produto()

        elif opcao == '2':
            listar_produtos()

        elif opcao == '3':
            nome = input('Digite o nome do produto: ')
            pesquisar_produto(nome)

        elif opcao == '4':
            nome = input('Digite o nome do produto: ')
            novo_preco = input('Digite o valor do produto: ')
            alterar_preco(nome, novo_preco)

        elif opcao == '5':
            nome = input('Digite o nome do produto: ')
            nova_quantidade = int(input('Digite a quantidade do produto: '))
            alterar_quantidade(nome, nova_quantidade)

        elif opcao == '6':
            nome = input('Digite o nome do produto: ')
            excluir_produto(nome)

        elif opcao == '7':
            realizar_venda()

        elif opcao == '8':
            historico()

        elif opcao == '9':
            estatistica()

        elif opcao == '10':
            estoque_baixo()

        elif opcao == '11':
            categoria = input('Digite o categoria do produto: ')
            pesquisar_categoria(categoria)

        elif opcao == '12':
            relatorio_vendas_produto()

        elif opcao == '0':
            print('Encerrando o programa.')
            break

        else:
            print('Opcao invalida. Tente novamente.')


carregar_produtos()
carregar_venda()
if login():
    menu()

else:
    print('Acesso Bloqueiado')
